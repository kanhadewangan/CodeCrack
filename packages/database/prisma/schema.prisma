
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model user {
  id       String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  userStat userStat[]
  submissions submissions[]
  leaderboard leaderboard[]
  contribution contribution[]
}

model userStat{
  id      String   @id @default(cuid())
  userId   String   @unique
  problemsSolved Int @default(0)
  totalSubmissions Int @default(0)
  rating Int @default(200)
  createdAt DateTime @default(now())
  users user @relation(fields: [userId], references: [id])
}

enum difficulty {
  EASY
  MEDIUM
  HARD
}
model problems {
  id       String   @id @default(cuid())
  title     String
  slug     String   @unique
  description   String
  difficulty   difficulty
  tags  String[]
  createdAt DateTime @default(now())
  testCases testCase[]
  submissions submissions[]
  contribution contribution[]
}


model testCase {
  id       String   @id @default(cuid())
  problemId   String
  input     String
  output   String
  createdAt DateTime @default(now())
  problem  problems   @relation(fields: [problemId], references: [id])
  @@index([problemId])
}

model tags {
  id       String   @id @default(cuid())
  name     String   @unique
  createdAt DateTime @default(now())
}
enum SubmissionStatus {
  PENDING
  RUNNING
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  RUNTIME_ERROR
}

model submissions {
  id       String   @id @default(cuid())
  userId   String
  problemId   String
  code     String
  language   String
  status   SubmissionStatus @default(PENDING)
  createdAt DateTime @default(now())
  users user @relation(fields: [userId], references: [id])
  problems problems @relation(fields: [problemId], references: [id])
  submissionStats submissionStats[]
  @@index([userId])
  @@index([problemId])
  @@index([status])
}

model submissionStats {
  id       String   @id @default(cuid())
  submissionId   String
  executionTime   Float
  memoryUsage   Float
  createdAt DateTime @default(now())
  submissions submissions @relation(fields: [submissionId], references: [id])
}

model contribution{
  id      String   @id @default(cuid())
  userId   String
  problemId   String
  createdAt DateTime @default(now())

  users user @relation(fields: [userId], references: [id])
  problems problems @relation(fields: [problemId], references: [id])
  @@index([userId,createdAt]) 
}

model leaderboard {
  id       String   @id @default(cuid())
  userId   String
  rating   Int
  createdAt DateTime @default(now())
  users user @relation(fields: [userId], references: [id])
}